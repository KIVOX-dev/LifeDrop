# ==============================================================================
# LifeDrop environment (copy to .env - NEVER commit the real file).
# Quick start:  node scripts/generate-env.js   (creates .env with random secrets)
# ==============================================================================

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
# Public URL of the API as seen by browsers/email clients (used for one-click unsubscribe links).
API_BASE_URL=http://localhost:5000/api/v1

# --- MongoDB -------------------------------------------------------------------
# Used when running the API outside Docker. docker-compose builds the authenticated URI
# from the two MONGO_ROOT_* values below, so these never appear in build arguments.
MONGODB_URI=mongodb://mongodb:27017/lifedrop
MONGO_ROOT_USERNAME=lifedrop
MONGO_ROOT_PASSWORD=REPLACE_WITH_STRONG_SECRET

# --- Auth ----------------------------------------------------------------------
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use DIFFERENT values for local and production, and for access vs refresh.
JWT_ACCESS_SECRET=REPLACE_WITH_STRONG_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_STRONG_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Set to true once the site is served over HTTPS (marks the refresh cookie Secure).
COOKIE_SECURE=false

# First SUPER_ADMIN, created on first start when none exists. Change the password after logging in.
SEED_SUPER_ADMIN_EMAIL=YOUR_ADMIN_EMAIL
SEED_SUPER_ADMIN_PASSWORD=REPLACE_WITH_STRONG_SECRET

# --- Brevo (transactional email) -------------------------------------------------
BREVO_API_KEY=YOUR_BREVO_API_KEY
BREVO_SENDER_EMAIL=YOUR_VERIFIED_SENDER_EMAIL
BREVO_SENDER_NAME=LifeDrop
BREVO_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# --- Backblaze B2 (S3-compatible, PRIVATE bucket) ---------------------------------
B2_ENDPOINT=YOUR_BACKBLAZE_S3_ENDPOINT
B2_REGION=YOUR_BACKBLAZE_REGION
B2_BUCKET_NAME=YOUR_BUCKET_NAME
B2_KEY_ID=YOUR_BACKBLAZE_KEY_ID
B2_APPLICATION_KEY=YOUR_BACKBLAZE_APPLICATION_KEY

# --- Groq AI ---------------------------------------------------------------------
# One key, or several separated by commas (rotated automatically on rate limits).
GROQ_API_KEY=YOUR_GROQ_API_KEY
# Free-tier friendly open-weight model, e.g. openai/gpt-oss-20b
GROQ_MODEL=YOUR_SUPPORTED_GROQ_MODEL

# --- Job queue (BullMQ on Redis) ---------------------------------------------------
QUEUE_REDIS_URL=redis://redis:6379
APP_TIMEZONE=Asia/Kolkata

# Optional: use an external MongoDB (e.g. Atlas) from the Docker stack instead of the bundled one.
# MONGODB_URI_DOCKER=mongodb+srv://USER:PASSWORD@HOST/lifedrop

# --- Docker Compose ports ----------------------------------------------------------
FRONTEND_PORT=5173
API_PORT=5000
# Public, non-secret path the browser uses for the API (nginx proxies it to the backend).
VITE_API_BASE_URL=/api/v1
