server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  include /etc/nginx/security-headers.conf;

  gzip on;
  gzip_comp_level 5;
  gzip_min_length 512;
  gzip_types text/plain text/css application/json application/javascript text/javascript image/svg+xml;

  server_tokens off;
  client_max_body_size 6m;   # certificates are limited to 5 MB by the API

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 'ok';
  }

  # API reverse proxy (same origin => the httpOnly refresh cookie just works)
  location /api/ {
    proxy_pass ${BACKEND_URL};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
  }

  # Fingerprinted build assets can be cached forever.
  location /assets/ {
    expires 1y;
    access_log off;
    try_files $uri =404;
  }

  # SPA fallback: unknown paths are handled by React Router. index.html is never cached.
  location / {
    expires -1;
    try_files $uri $uri/ /index.html;
  }
}
